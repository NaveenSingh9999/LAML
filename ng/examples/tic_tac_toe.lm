~ Tic-Tac-Toe with unbeatable AI (Minimax)

func printBoard(board) {
    say ""
    say " " + board[0] + " | " + board[1] + " | " + board[2]
    say "---+---+---"
    say " " + board[3] + " | " + board[4] + " | " + board[5]
    say "---+---+---"
    say " " + board[6] + " | " + board[7] + " | " + board[8]
    say ""
}

func getWinner(board) {
    ~ rows
    if board[0] != " " && board[0] == board[1] && board[1] == board[2] { return board[0] }
    if board[3] != " " && board[3] == board[4] && board[4] == board[5] { return board[3] }
    if board[6] != " " && board[6] == board[7] && board[7] == board[8] { return board[6] }
    ~ columns
    if board[0] != " " && board[0] == board[3] && board[3] == board[6] { return board[0] }
    if board[1] != " " && board[1] == board[4] && board[4] == board[7] { return board[1] }
    if board[2] != " " && board[2] == board[5] && board[5] == board[8] { return board[2] }
    ~ diagonals
    if board[0] != " " && board[0] == board[4] && board[4] == board[8] { return board[0] }
    if board[2] != " " && board[2] == board[4] && board[4] == board[6] { return board[2] }
    return " "
}

func isFull(board) {
    let i = 0
    while i < 9 {
        if board[i] == " " { return false }
        i = i + 1
    }
    return true
}

func minimax(board, isMax) {
    let winner = getWinner(board)
    if winner == "X" { return -10 }
    if winner == "O" { return 10 }
    if isFull(board) { return 0 }

    if isMax {
        let best = -1000
        let i = 0
        while i < 9 {
            if board[i] == " " {
                board[i] = "O"
                let score = minimax(board, false)
                board[i] = " "
                if score > best { best = score }
            }
            i = i + 1
        }
        return best
    } else {
        let best = 1000
        let i = 0
        while i < 9 {
            if board[i] == " " {
                board[i] = "X"
                let score = minimax(board, true)
                board[i] = " "
                if score < best { best = score }
            }
            i = i + 1
        }
        return best
    }
}

func aiMove(board) {
    let bestScore = -1000
    let bestMove = -1
    let i = 0
    while i < 9 {
        if board[i] == " " {
            board[i] = "O"
            let score = minimax(board, false)
            board[i] = " "
            if score > bestScore {
                bestScore = score
                bestMove = i
            }
        }
        i = i + 1
    }
    return bestMove
}

func isBoardFull(board) {
    let i = 0
    while i < 9 {
        if board[i] == " " { return false }
        i = i + 1
    }
    return true
}

~ Game loop
let board = [" ", " ", " ", " ", " ", " ", " ", " ", " "]
let gameOver = false
let pos = -1

say "╔══════════════════════════════╗"
say "║     Tic-Tac-Toe vs AI       ║"
say "║  You are X, AI is O         ║"
say "║  Enter position 1-9:        ║"
say "║                             ║"
say "║  1 | 2 | 3                  ║"
say "║ ---+---+---                 ║"
say "║  4 | 5 | 6                  ║"
say "║ ---+---+---                 ║"
say "║  7 | 8 | 9                  ║"
say "╚══════════════════════════════╝"

while !gameOver {
    printBoard(board)

    ~ player move
    let valid = false
    while !valid {
        pos = -1
        say "Your move (1-9): "
        let input = readLine()
        if input == "1" { pos = 0 }
        if input == "2" { pos = 1 }
        if input == "3" { pos = 2 }
        if input == "4" { pos = 3 }
        if input == "5" { pos = 4 }
        if input == "6" { pos = 5 }
        if input == "7" { pos = 6 }
        if input == "8" { pos = 7 }
        if input == "9" { pos = 8 }
        if pos >= 0 {
            if board[pos] == " " {
                board[pos] = "X"
                valid = true
            } else {
                say "Spot taken! Try again."
            }
        } else {
            say "Invalid! Enter 1-9."
        }
    }

    let winner = getWinner(board)
    if winner != " " {
        printBoard(board)
        if winner == "X" { say "╔═══════════════════╗" say "║  You win! 🏆      ║" say "╚═══════════════════╝" }
        if winner == "O" { say "╔═══════════════════╗" say "║  AI wins! 🤖      ║" say "╚═══════════════════╝" }
        gameOver = true
    } else {
        if isBoardFull(board) {
            printBoard(board)
            say "╔═══════════════════╗"
            say "║  It's a draw!    ║"
            say "╚═══════════════════╝"
            gameOver = true
        }
    }

    if !gameOver {
        ~ ai move
        let move = aiMove(board)
        board[move] = "O"
        say "AI plays position " + (move + 1)

        let winner = getWinner(board)
        if winner != " " {
            printBoard(board)
            if winner == "X" { say "╔═══════════════════╗" say "║  You win! 🏆      ║" say "╚═══════════════════╝" }
            if winner == "O" { say "╔═══════════════════╗" say "║  AI wins! 🤖      ║" say "╚═══════════════════╝" }
            gameOver = true
        } else {
            if isBoardFull(board) {
                printBoard(board)
                say "╔═══════════════════╗"
                say "║  It's a draw!    ║"
                say "╚═══════════════════╝"
                gameOver = true
            }
        }
    }
}

say ""
say "Thanks for playing!"
