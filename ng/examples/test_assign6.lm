let board = [" ", " ", " ", " ", " ", " ", " ", " ", " "]
let gameOver = false
let pos = -1

while !gameOver {
    let valid = false
    while !valid {
        pos = -1
        say "Your move: "
        let input = readLine()
        if input == "5" {
            pos = 4
            board[pos] = "X"
        }
        if pos >= 0 { valid = true }
    }
    gameOver = true
}
say board[4]
