~ LAML-NG HTTP/1.0 File Server
~ Usage: socat TCP-LISTEN:8080,fork EXEC:"./laml run server.lm"

func chr(c) {
    if c == 32 { return " " }
    if c == 33 { return "!" }
    if c == 34 { return "\"" }
    if c == 35 { return "#" }
    if c == 36 { return "$" }
    if c == 37 { return "%" }
    if c == 38 { return "&" }
    if c == 39 { return "'" }
    if c == 40 { return "(" }
    if c == 41 { return ")" }
    if c == 42 { return "*" }
    if c == 43 { return "+" }
    if c == 44 { return "," }
    if c == 45 { return "-" }
    if c == 46 { return "." }
    if c == 47 { return "/" }
    if c >= 48 && c <= 57 {
        val n = c - 48
        if n == 0 { return "0" } if n == 1 { return "1" }
        if n == 2 { return "2" } if n == 3 { return "3" }
        if n == 4 { return "4" } if n == 5 { return "5" }
        if n == 6 { return "6" } if n == 7 { return "7" }
        if n == 8 { return "8" } if n == 9 { return "9" }
    }
    if c >= 65 && c <= 90 {
        val n = c - 65
        if n == 0 { return "A" } if n == 1 { return "B" }
        if n == 2 { return "C" } if n == 3 { return "D" }
        if n == 4 { return "E" } if n == 5 { return "F" }
        if n == 6 { return "G" } if n == 7 { return "H" }
        if n == 8 { return "I" } if n == 9 { return "J" }
        if n == 10 { return "K" } if n == 11 { return "L" }
        if n == 12 { return "M" } if n == 13 { return "N" }
        if n == 14 { return "O" } if n == 15 { return "P" }
        if n == 16 { return "Q" } if n == 17 { return "R" }
        if n == 18 { return "S" } if n == 19 { return "T" }
        if n == 20 { return "U" } if n == 21 { return "V" }
        if n == 22 { return "W" } if n == 23 { return "X" }
        if n == 24 { return "Y" } if n == 25 { return "Z" }
    }
    if c >= 97 && c <= 122 {
        val n = c - 97
        if n == 0 { return "a" } if n == 1 { return "b" }
        if n == 2 { return "c" } if n == 3 { return "d" }
        if n == 4 { return "e" } if n == 5 { return "f" }
        if n == 6 { return "g" } if n == 7 { return "h" }
        if n == 8 { return "i" } if n == 9 { return "j" }
        if n == 10 { return "k" } if n == 11 { return "l" }
        if n == 12 { return "m" } if n == 13 { return "n" }
        if n == 14 { return "o" } if n == 15 { return "p" }
        if n == 16 { return "q" } if n == 17 { return "r" }
        if n == 18 { return "s" } if n == 19 { return "t" }
        if n == 20 { return "u" } if n == 21 { return "v" }
        if n == 22 { return "w" } if n == 23 { return "x" }
        if n == 24 { return "y" } if n == 25 { return "z" }
    }
    "?"
}

func hexVal(c) {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 65 + 10 }
    if c >= 97 && c <= 102 { return c - 97 + 10 }
    -1
}

func urlDecode(s) {
    val out = ""
    val i = 0
    loop i < len(s) {
        val c = s[i]
        if c == 43 {
            out = out + " "
            i = i + 1
        } else {
            if c == 37 && i + 2 < len(s) {
                val hv = hexVal(s[i + 1])
                val lv = hexVal(s[i + 2])
                if hv >= 0 && lv >= 0 {
                    val code = hv * 16 + lv
                    out = out + chr(code)
                    i = i + 3
                } else {
                    out = out + chr(c)
                    i = i + 1
                }
            } else {
                out = out + chr(c)
                i = i + 1
            }
        }
    }
    out
}

func contentType(path) {
    val L = len(path)
    if L >= 5 {
        if path[L - 5] == 46 {
            val s = chr(path[L - 4]) + chr(path[L - 3]) + chr(path[L - 2]) + chr(path[L - 1])
            if s == "html" { return "text/html" }
        }
    }
    if L >= 4 {
        if path[L - 4] == 46 {
            val s = chr(path[L - 3]) + chr(path[L - 2]) + chr(path[L - 1])
            if s == "css"  { return "text/css" }
            if s == "txt"  { return "text/plain" }
            if s == "xml"  { return "application/xml" }
            if s == "json" { return "application/json" }
            if s == "js"   { return "application/javascript" }
            if s == "png"  { return "image/png" }
            if s == "jpg"  { return "image/jpeg" }
            if s == "gif"  { return "image/gif" }
            if s == "svg"  { return "image/svg+xml" }
            if s == "ico"  { return "image/x-icon" }
        }
    }
    "text/plain"
}

~ ===== Main =====

val requestLine = readLine()
if type(requestLine) == "nil" { return }

val method = ""
val rawPath = ""
val parseState = 0
val Li = 0
loop Li < len(requestLine) {
    val c = requestLine[Li]
    if c == 32 {
        parseState = parseState + 1
    } else {
        if parseState == 0 { method = method + chr(c) }
        if parseState == 1 { rawPath = rawPath + chr(c) }
    }
    Li = Li + 1
}

if method != "GET" {
    say("HTTP/1.0 405 Method Not Allowed\r")
    say("Content-Type: text/plain\r")
    say("\r")
    say("Method not allowed")
    return
}

val docRoot = "www"
val decoded = urlDecode(rawPath)
val cleanPath = decoded
if len(cleanPath) > 0 && cleanPath[len(cleanPath) - 1] == 47 {
    cleanPath = cleanPath + "index.html"
}
val filePath = docRoot + cleanPath
val body = readFile(filePath)

if type(body) == "error" {
    val altPath = filePath + "/index.html"
    val altBody = readFile(altPath)
    if type(altBody) == "error" {
        say("HTTP/1.0 404 Not Found\r")
        say("Content-Type: text/html\r")
        say("\r")
        say("<html><body><h1>404 Not Found</h1>")
        say("<p>" + decoded + "</p>")
        say("<p><a href=\"/\">Home</a></p>")
        say("</body></html>")
    } else {
        say("HTTP/1.0 200 OK\r")
        say("Content-Type: " + contentType(altPath) + "\r")
        say("\r")
        say(altBody)
    }
} else {
    say("HTTP/1.0 200 OK\r")
    say("Content-Type: " + contentType(filePath) + "\r")
    say("\r")
    say(body)
}
